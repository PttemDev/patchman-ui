# Tenant-specific FE values. Copy to `.env.tenant` (gitignored) and fill
# in before running `vite build`. Vite picks these up automatically when
# the file exists; values are baked into the bundle at build time, so a
# new client needs a fresh build.
#
# Empty values fall back to the neutral defaults in src/lib/tenant.ts
# (generic example domain / hostnames) so a no-config build still runs.

# Domain shown in the "you@<domain>" placeholder on Login/Register.
# Match this to the BE's ALLOWED_EMAIL_DOMAINS so the example is
# guaranteed to pass validation.
VITE_EMAIL_DOMAIN_PLACEHOLDER=

# Bare GitLab hostname (no scheme) used in user-visible copy:
#   "Approve PatchMan on <hostname>"
#   "https://<hostname>/group/repo/-/blob/..."
VITE_GITLAB_HOSTNAME=

# Remote BE base URL. Used by the desktop sidecar fallback path and the
# load-test live stream. Leave empty to use the same-origin /api proxy.
VITE_API_URL=

# Embedded BE URL for desktop dev runs without Tauri. Production builds
# get this from window.__PATCHMAN_LOCAL_API__ injected by the sidecar.
VITE_LOCAL_API_URL=
