# Copy to `.env` (gitignored) for local development. Vite exposes only
# variables prefixed with VITE_, and bakes them into the bundle at build time.
# See .env.tenant.example for per-deployment branding values.

# Backend API base URL. Leave empty (or `/api`) to use the same-origin proxy;
# in development Vite proxies /api to http://localhost:8085.
VITE_API_URL=/api
